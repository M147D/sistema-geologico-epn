# Copiar a .env y completar. .env no se commitea (en el servidor: chmod 600).

# ── Solo desarrollo ─────────────────────────────────────────────────────────
# Tu usuario, si no es 1000 (id -u / id -g).
UID_HOST=1000
GID_HOST=1000

# ── Producción (compose.prod.yaml) ──────────────────────────────────────────
# Sin valor a propósito: el arranque falla si falta alguno.
# En desarrollo son opcionales: compose.yaml trae valores de prueba.
DOMINIO=
POSTGRES_PASSWORD=
APP_DB_USER=
APP_DB_PASSWORD=
# Al menos 32 caracteres aleatorios: openssl rand -base64 48
JWT_SECRET=
# Superadministrador que se crea al migrar si no existe. Cambiar la contraseña
# desde la aplicación después del primer ingreso.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo para la solicitud de informe petrográfico (opcional).
SMTP_HOST=
SMTP_PORT=587
SMTP_SENDER_EMAIL=
SMTP_PASSWORD=
INFORME_DESTINO=

# Para probar compose.prod.yaml en el equipo: DOMINIO=localhost y puertos libres.
# PUERTO_HTTP=8080
# PUERTO_HTTPS=8443
